# Required: MongoDB Atlas connection string
MONGO_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/nexusvibe?retryWrites=true&w=majority

# Optional: server-side reCAPTCHA secret (enables captcha check on /api/contact)
RECAPTCHA_SECRET_KEY=

# Frontend (Vite) - leave unset on Vercel so the app calls same-origin /api
# VITE_API_URL=
# VITE_RECAPTCHA_SITE_KEY=
