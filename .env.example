# Set MONGODB_URI to use MongoDB Atlas. If unset, JsonDB Lite is used locally.
# Copy this file to .env and paste your Atlas connection string there.
MONGODB_URI=mongodb+srv://<db-user>:<db-password>@<cluster-host>/nexusvibe?retryWrites=true&w=majority

# Optional local JsonDB data folder (used when MONGODB_URI is unset)
JSONDB_DIR=./data

# Local API server port
API_PORT=3001
